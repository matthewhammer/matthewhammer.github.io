 "ingredients": [
  {
   "key": "answer",
   "kind": "A",
   "lo": 2840,
   "hi": 4810,
   "per": "a step",
   "name": "Send the worker's answer without what the page does not read",
   "what": "The worker ran the whole program on the interpreter and sent back every probe sample with its environment, closures and all, and a trace, about 5 MB of terms; the picture waited for it. Two cuts (no function-holding values in the samples' environments, no trace), then no sharing between answers. Later the answer went without a stream the page dropped on arrival, and its first-order values as data (590 KB to 198 KB).",
   "measured": "A step's picture 4.17 to 6.52 s on build 1, 1.85 to 2.38 s on build 2, 1.33 to 1.71 s on build 3 (report 046). The answer 590 KB to 198 KB on build 20; the worker's encode 72 to 107 ms to 21 to 29, the page's decode 24 to 31 ms to 7 to 8.",
   "today": "The picture no longer waits for the worker. Its answer still comes 1.5 to 2.4 s after a step, and costs the page 7 to 10 ms to decode.",
   "builds": [
    2,
    3,
    20
   ],
   "commits": [
    "20a3067c18",
    "4747a4120d",
    "01a5e8ecb0",
